# Local development credentials only. Never reuse these in production.
POSTGRES_PASSWORD=local-postgres-only
API_TOKEN=local-demo-token-change-me
# Used by `go run ./cmd/server` on the host, not the Compose app container.
DATABASE_URL=postgres://blotato:local-postgres-only@localhost:55432/blotato?sslmode=disable
DEMO_MODE=true
TENANT_ID=tenant-demo
